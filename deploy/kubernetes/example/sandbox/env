# The sandbox's settings that are neither surrogates nor endpoints
# (ConfigMap penelope-sandbox-env, together with surrogates.env).
# Who she is, shown in her system prompt.
PENELOPE_NAME=Example
PENELOPE_ROLE=The owner's companion, also on Slack
PENELOPE_OWNER=example-owner (example-owner on GitHub)
# <provider>/<model> of Pi. The provider's endpoint and surrogate are in models.json.
PENELOPE_MODEL=openai/gpt-5.5
# Go down a list of models by the first one's usage and by refusals, with PENELOPE_MODEL=router/auto (docs/model-router.md).
# PENELOPE_MODEL_ROUTER={"models":["openai/gpt-5.5","xai/grok-4.3","anthropic/claude-sonnet-4-5"],"prometheus":"http://prometheus.example:9090","query":"max(codex_rate_limit_used_percent)"}
# The time of the tools and of what the runner draws.
TZ=Asia/Tokyo
# Slack's events drawn into the turn: the source of the Slack plugin (receivers/config.json).
PENELOPE_SLACK_SOURCES=slack
# slackctl post --face makes the icon's URL from this (the same as the backend's).
PENELOPE_PUBLIC_URL=https://penelope.example.com
# When Slack cannot reach the backend, the icons are <this>/<face>.png instead.
# PENELOPE_SLACK_ICON_BASE_URL=https://icons.example.com/example
# Where sdctl writes what she draws.
SDCTL_FORMAT=jpeg
SDCTL_OUTPUT_DIR=/home/agent/work/images
